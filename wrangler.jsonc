{
  // Cloudflare Worker: serves the Vite build in ./dist as a single-page app.
  "name": "swiftlift",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
